# CaLẻ / Now — environment variable example
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored and MUST NOT be committed.
#
# IMPORTANT: The current app is a localStorage-only demo and does NOT read
# any of these yet. They are placeholders for the planned BACKEND-MIGRATION-1
# (Supabase). See docs/SUPABASE_SECURITY_NOTE.md before filling them in.
# ---------------------------------------------------------------------------

# Supabase project URL.
# Safe to expose to the browser (NEXT_PUBLIC_ prefix). Shareable with app config.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key.
# Safe to use in the browser ONLY IF Row Level Security (RLS) + policies are
# configured correctly. NEXT_PUBLIC_ variables are bundled into the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase database connection string (Postgres).
# SERVER / MIGRATION ONLY. Never prefix with NEXT_PUBLIC_. Never expose to
# the browser. Used by migration scripts / server code only.
SUPABASE_DATABASE_URL=

# ---------------------------------------------------------------------------
# NEVER put the Supabase secret key / service_role key in this file, in any
# NEXT_PUBLIC_ variable, in client code, in logs, or in public chat.
# If a secret/service_role key was ever pasted publicly, rotate/revoke it in
# the Supabase dashboard before starting backend migration.
# ---------------------------------------------------------------------------
