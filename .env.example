# CaLẻ / Now — environment variable example
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored and MUST NOT be committed.
#
# BACKEND-MIGRATION-1 · Phase 1 (Auth + Profile). See docs/PHASE_1_PLAN.md and
# docs/SUPABASE_SECURITY_NOTE.md before filling them in.
# ---------------------------------------------------------------------------

# Data source selector (BẮT BUỘC tường minh — không suy từ việc có URL/key).
#   local    → dùng localStorage (demo hiện tại; mặc định khi không phải prod).
#   supabase → dùng Supabase (yêu cầu URL + anon key bên dưới, nếu thiếu → throw).
# Production BẮT BUỘC =supabase. Để trống ở dev = local.
NEXT_PUBLIC_DATA_MODE=local

# Supabase project URL.
# Safe to expose to the browser (NEXT_PUBLIC_ prefix). Shareable with app config.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key.
# Safe to use in the browser ONLY IF Row Level Security (RLS) + policies are
# configured correctly. NEXT_PUBLIC_ variables are bundled into the client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# CÔNG KHAI (hiện trong HTML client) — không phải secret. Để trống = tắt GA.
# Code có ID mặc định của luồng CaLẻ nên chạy ngay; đặt biến này để override.
NEXT_PUBLIC_GA_ID=

# Bật nạp tiền THẬT qua PayOS ở giao diện ví (=true). Để trống/false → giữ luồng
# nạp mô phỏng. CÔNG KHAI (client) — chỉ là cờ bật/tắt, KHÔNG phải secret.
# Cần đồng thời cấu hình các secret PayOS_* trong Edge Function (xem bên dưới).
NEXT_PUBLIC_PAYOS_ENABLED=false

# ---------------------------------------------------------------------------
# PayOS — thanh toán THẬT. CÁC BIẾN NÀY LÀ SECRET, KHÔNG NEXT_PUBLIC_, KHÔNG đặt
# ở .env.local của app hay Vercel. Đặt trong SUPABASE EDGE FUNCTION SECRETS:
#   supabase secrets set PAYOS_CLIENT_ID=... PAYOS_API_KEY=... PAYOS_CHECKSUM_KEY=...
#   supabase secrets set PAYOS_RETURN_URL=https://cale.io.vn/... PAYOS_CANCEL_URL=...
# Edge Function dùng: create-payment (Kênh thu) + payos-webhook (xác nhận trả).
#   PAYOS_CLIENT_ID     — Client ID kênh PayOS
#   PAYOS_API_KEY       — API Key kênh PayOS
#   PAYOS_CHECKSUM_KEY  — Checksum Key (ký/verify chữ ký) — TUYỆT ĐỐI không lộ client
#   PAYOS_RETURN_URL    — URL redirect khi trả thành công
#   PAYOS_CANCEL_URL    — URL redirect khi huỷ
#   PAYOS_DESCRIPTION   — (tuỳ chọn) mô tả trên QR, mặc định "CALE nap vi"
#   PAYOS_MOCK          — =true để chạy MÔ PHỎNG toàn bộ luồng nạp KHÔNG cần
#                         PayOS account / STK (QR giả, bấm "đã chuyển khoản" là
#                         cộng ví ngay). Đổi 'false' + cắm 5 secret trên khi có
#                         tài khoản thật. Chỉ đặt trong Edge Function secrets.
# Webhook (chỉ chế độ THẬT): khai báo URL Edge Function `payos-webhook` trong
# dashboard PayOS.
#
# TEST MÔ PHỎNG nhanh (không cần đăng ký gì):
#   NEXT_PUBLIC_PAYOS_ENABLED=true   (Vercel / .env.local — bật UI PayOS)
#   supabase secrets set PAYOS_MOCK=true   (Edge Function — chạy giả lập)
#   supabase functions deploy create-payment
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# CHỈ 3 biến NEXT_PUBLIC_ ở trên được đặt trong .env.local của app và Vercel.
#
# KHÔNG đặt database password hay service_role key ở file này / Vercel / client
# code / log / chat (điều kiện bảo mật Phase 1).
#   - Migration chạy qua Supabase CLI: `supabase login` + `supabase link`
#     (tương tác trên máy chủ dự án) → `supabase db push`. Secret nằm trong phiên
#     CLI, không qua env của app.
#   - Nếu lỡ lộ secret/service_role → rotate/revoke ngay trong dashboard.
# ---------------------------------------------------------------------------
